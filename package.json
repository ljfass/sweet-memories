{
  "name": "sweet-memories",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@8.6.1",
  "scripts": {
    "dev": "vite",
    "build": "pnpm build:frontend && pnpm build:api",
    "build:frontend": "vite build",
    "build:api": "pnpm --dir apps/api build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && pnpm --dir apps/api typecheck",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:api": "pnpm --dir apps/api test && bash scripts/deploy/package-api.test.sh",
    "test:watch": "vitest",
    "test:deploy": "bash scripts/deploy/manage-release.test.sh",
    "test:data-backup": "bash scripts/ops/data-backup.test.sh",
    "test:monitor": "python3 scripts/monitor/test_extract_assets.py && bash scripts/monitor/check-site.test.sh",
    "test:lighthouse": "vitest run scripts/lighthouse",
    "media:build": "node scripts/optimize-media.mjs",
    "media:verify": "node scripts/verify-media.mjs",
    "package:api": "bash scripts/deploy/package-api.sh"
  },
  "dependencies": {
    "@lucide/vue": "^1.33.0",
    "gsap": "^3.13.0",
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "0.15.1",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.8.1",
    "eslint-plugin-vue": "^10.10.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "globals": "^17.11.0",
    "happy-dom": "^20.11.6",
    "sharp": "^0.35.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.10",
    "yaml": "^2.8.2"
  }
}
